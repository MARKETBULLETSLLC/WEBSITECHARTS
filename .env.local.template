# Environment variables template - COPY TO .env.local and fill in with real values
# Never commit .env.local to version control

# Google Sheets API Configuration (REQUIRED)
GOOGLE_SHEETS_PROJECT_ID=your-gcp-project-id
GOOGLE_SHEETS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEETS_CLIENT_EMAIL=service-account@your-project.iam.gserviceaccount.com
GOOGLE_SHEETS_ID=your-spreadsheet-id

# Google Sheets API Configuration (OPTIONAL - has defaults if not provided)
GOOGLE_SHEETS_PRIVATE_KEY_ID=your-private-key-id
GOOGLE_SHEETS_CLIENT_ID=your-client-id

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:3000
